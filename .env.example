# このファイルをコピーして .env.local を作り、値を入れてください（.env.local は git に含めない）

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Google ログイン（Auth.js）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# ログインを許可する Google アカウント（カンマ区切り）
ALLOWED_EMAILS=yamada@example.com,suzuki@example.com

# ログイン画面の合言葉
SITE_PASSWORD=

# 日報API用トークン（未設定なら常に401）
KPI_REPORT_TOKEN=

# ── デモ公開するときだけ ──
# 1 にすると、ログイン画面がワンクリックのデモログインになり、Gmail・カレンダーへの送信は止まり、
# 設定画面にサイトのカスタマイズ（CMS）が出る。本番では空のままにする
NEXT_PUBLIC_DEMO_MODE=
# 毎晩のデータ初期化（/api/demo/reset・vercel.json の crons）用。Vercel が自動で付ける
CRON_SECRET=
# Vercel 以外で動かすときに Auth.js のホスト確認を通す
AUTH_TRUST_HOST=
