# このファイルをコピーして .env.local を作り、値を入れてください（.env.local は git に含めない）

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Google ログイン（Auth.js）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# ログインを許可する Google アカウント（カンマ区切り）
ALLOWED_EMAILS=yamada@example.com,suzuki@example.com

# ログイン画面の合言葉
SITE_PASSWORD=

# 日報API用トークン（未設定なら常に401）
KPI_REPORT_TOKEN=
